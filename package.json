{
  "name": "kartavya-resume-engine",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "description": "Static adaptive resume engine and deterministic A4 PDF build for Kartavya Jharwal.",
  "author": "Kartavya Jharwal <KartavyaJharwal@gmail.com>",
  "homepage": "https://resume.kartavya.tech",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kartavya-Jharwal/resume"
  },
  "scripts": {
    "build": "bun run bun/src/build.js",
    "build:pdf": "bun run bun/src/build.js --pdf",
    "build:pdf:confirmed": "bun run bun/src/build.js --pdf --yes",
    "compile": "bun run bun/src/compile.js",
    "build:master-cv": "bun run bun/src/build-master-cv.js",
    "metrics": "bun run bun/src/font-metrics.js",
    "validate": "bun run bun/src/validate.js",
    "content:ids": "bun run bun/src/assign-content-ids.js",
    "content:plan": "bun run bun/src/plan-variant-content.js",
    "content:audit": "bun run bun/src/export-pillar4-audit.js",
    "test": "bun run build && bun run bun/src/test.js --skip-pdfs",
    "test:pdf": "bun run build:pdf && bun run bun/src/test.js",
    "test:pdf:confirmed": "bun run build:pdf:confirmed && bun run bun/src/test.js",
    "serve": "bun run build && bunx serve dist -l 3000",
    "preview": "bunx serve dist -l 3000",
    "deploy": "bun run bun/src/deploy.js",
    "deploy:pdf": "bun run bun/src/deploy.js --pdf",
    "clean": "bun -e \"for(const p of ['dist','.build-cache']){if(p==='dist'||p==='.build-cache')require('node:fs').rmSync(p,{recursive:true,force:true})}\""
  },
  "devDependencies": {
    "@types/bun": "latest",
    "fontkit": "2.0.4",
    "html-minifier-terser": "7.2.0",
    "lightningcss": "1.33.0",
    "pdf-lib": "1.17.1",
    "playwright": "1.61.1"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "motion": "^12.43.0"
  }
}
